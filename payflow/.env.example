# Copy to .env and adjust. Paths are relative to process cwd unless absolute.

# SQLite database file (app + Alembic use the same path)
DATABASE_PATH=data/payflow.db

HOST=127.0.0.1
PORT=3000
LOG_LEVEL=INFO

# Hot reload (dev). Set false for production-style runs.
RELOAD=true

# Browser / Swagger: use "*" for local dev, or comma-separated origins e.g.
# http://127.0.0.1:3000,http://localhost:3000
CORS_ORIGINS=*
