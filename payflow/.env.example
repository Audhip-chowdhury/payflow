# Copy to .env and adjust. Paths are relative to process cwd unless absolute.

DATABASE_PATH=data/payflow.db

HOST=127.0.0.1
PORT=3000
LOG_LEVEL=INFO

RELOAD=true

CORS_ORIGINS=*

ENABLE_WORKER=true
WORKER_INTERVAL_SECONDS=60

ENABLE_BATCH_WORKER=true
BATCH_WORKER_INTERVAL_SECONDS=120

# Wallet UUID that funds approved expense reimbursements (seed creates this id).
REIMBURSEMENT_WALLET_ID=00000000-0000-4000-8000-0000000000c0

# Phase 5 — in-process rate limits (per wallet / per user).
RATE_LIMIT_TRANSFERS_PER_WALLET_PER_MINUTE=1000
RATE_LIMIT_WINDOW_MINUTES=1
RATE_LIMIT_WALLET_CREATES_PER_USER_PER_HOUR=1000
